# Copy to .env. Every variable has a working local default; nothing here is a real secret.

# --- Data pipeline (Spark). On Databricks these are Unity Catalog volume paths, e.g. /Volumes/workspace/lending/lake
LDP_RAW_DIR=data/raw
LDP_LAKE_ROOT=data/lake
LDP_TRAINING_DIR=data/training
LDP_REPORTS_DIR=reports
LDP_SPARK_MASTER=local[*]
LDP_SPARK_DRIVER_MEMORY=8g
LDP_SPARK_SHUFFLE_PARTITIONS=64

# Out-of-time split
LDP_TRAIN_YEAR=2023
LDP_VALID_YEAR=2024
LDP_TEST_YEAR=2025

# --- Decision API. Keys are client:key pairs (keys at least 16 characters). In GCP they come from Secret Manager.
LDP_API_KEYS=local-branch-app:local-dev-key-branch-app-0001,local-replay:local-dev-key-replay-000002
LDP_RATE_LIMIT_PER_MINUTE=600
LDP_TFS_URL=http://localhost:8501
LDP_MODEL_NAME=ldp

# --- Decision events. The Google clients use the emulators when these are set.
LDP_GCP_PROJECT=ldp-local
PUBSUB_EMULATOR_HOST=localhost:8681
LDP_PUBSUB_TOPIC=decisions
LDP_PUBSUB_SUBSCRIPTION=decisions-bq-sink
LDP_BQ_DATASET=lending
LDP_BQ_TABLE=decisions
LDP_BQ_ENDPOINT=http://localhost:9050

# --- Monitoring
LDP_PUSHGATEWAY_URL=http://localhost:9091
LDP_MONITOR_WINDOW_HOURS=24
